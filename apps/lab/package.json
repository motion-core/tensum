{
	"name": "@real-spring/lab",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"dependencies": {
		"@real-spring/gsap-spring": "workspace:*",
		"@real-spring/spring-core": "workspace:*",
		"d3": "^7.9.0",
		"gsap": "^3.15.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
