{
  "name": "@motion-core/spring",
  "version": "0.1.0",
  "description": "Numerically stable analytical spring physics for JavaScript and TypeScript",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js"
    },
    "./coupled": {
      "types": "./dist/coupled.d.ts",
      "import": "./dist/coupled.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "benchmark": "pnpm build && node benchmarks/spring.mjs",
    "check": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
