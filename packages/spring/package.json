{
  "name": "@motion-core/spring",
  "version": "0.1.0",
  "description": "Analytical spring physics as a native GSAP plugin",
  "license": "MIT",
  "author": "Motion Core",
  "keywords": [
    "animation",
    "gsap",
    "physics",
    "spring"
  ],
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "import": "./dist/css.js"
    },
    "./coupled": {
      "types": "./dist/coupled.d.ts",
      "import": "./dist/coupled.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "benchmark": "pnpm build && pnpm benchmark:physics && pnpm benchmark:gsap",
    "benchmark:physics": "node benchmarks/physics/spring.mjs",
    "benchmark:gsap": "node benchmarks/gsap/adapter.mjs",
    "check": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "4.1.10",
    "gsap": "^3.15.0",
    "playwright": "1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
